# Copy this file to .env and fill in the values. Never commit the real .env.

PORT=8000
MONGODB_URL=
JWT_SECRET=

# Firebase project id (Firebase console -> Project settings -> General). Used to verify Google sign-in.
# No service account or secret key is needed for this.
FIREBASE_PROJECT_ID=

# Cloudinary (image uploads, used later). The URL contains a secret, so it stays in backend/.env only.
CLOUDINARY_URL=
